    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 2. 特征工程：处理类别特征与数值特征\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\"*60)\\n\",\n",
    "    \"print(\\\"2. 特征工程\\\")\\n\",\n",
    "    \"print(\\\"=\\\"*60)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ------------------------------------------------------------\\n\",\n",
    "    \"# Step 1: 处理无穷值和缺失值\\n\",\n",
    "    \"# ------------------------------------------------------------\\n\",\n",
    "    \"X = X.replace([np.inf, -np.inf], np.nan)\\n\",\n",
    "    \"null_count = X.isnull().sum().sum()\\n\",\n",
    "    \"if null_count > 0:\\n\",\n",
    "    \"    print(f\\\"[WARNING] 存在 {null_count} 个缺失值，使用中位数填充\\\")\\n\",\n",
    "    \"    X = X.fillna(X.median())\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ------------------------------------------------------------\\n\",\n",
    "    \"# Step 2: 分离数值特征和类别特征\\n\",\n",
    "    \"# ------------------------------------------------------------\\n\",\n",
    "    \"# 数值特征：所有数值型的列，但要排除掉 CATEGORICAL_COLS 中明确指定的\\n\",\n",
    "    \"numerical_cols = X.select_dtypes(include=[np.number]).columns.tolist()\\n\",\n",
    "    \"# 确保 CATEGORICAL_COLS 中的列（即使它是数值）被当作类别处理\\n\",\n",
    "    \"numerical_cols = [col for col in numerical_cols if col not in categorical_found]\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"[INFO] 数值特征数量: {len(numerical_cols)}\\\")\\n\",\n",
    "    \"print(f\\\"[INFO] 类别特征数量: {len(categorical_found)}\\\")\\n\",\n",
    "    \"if categorical_found:\\n\",\n",
    "    \"    for col in categorical_found:\\n\",\n",
    "    \"        unique_vals = X[col].nunique()\\n\",\n",
    "    \"        print(f\\\"  - {col}: {unique_vals} 个唯一值 (dtype: {X[col].dtype})\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ------------------------------------------------------------\\n\",\n",
    "    \"# Step 3: One-Hot 编码类别特征（替换原来的 Label Encoding）\\n\",\n",
    "    \"# ------------------------------------------------------------\\n\",\n",
    "    \"if categorical_found:\\n\",\n",
    "    \"    # 使用 pd.get_dummies 进行 One-Hot 编码\\n\",\n",
    "    \"    # drop_first=False: 保留所有类别列（不丢掉参考类别）\\n\",\n",
    "    \"    # 这样每个类别都有独立的列，模型更容易学习\\n\",\n",
    "    \"    X_categorical_onehot = pd.get_dummies(\\n\",\n",
    "    \"        X[categorical_found],\\n\",\n",
    "    \"        columns=categorical_found,\\n\",\n",
    "    \"        drop_first=False,      # 保留所有类别\\n\",\n",
    "    \"        prefix_sep='_',        # 前缀分隔符\\n\",\n",
    "    \"        dtype=int               # 使用 int 而非 bool\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(f\\\"[INFO] One-Hot 编码完成\\\")\\n\",\n",
    "    \"    print(f\\\"[INFO] 原始类别特征: {len(categorical_found)} 列\\\")\\n\",\n",
    "    \"    print(f\\\"[INFO] One-Hot 后新增: {X_categorical_onehot.shape[1]} 列\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 打印编码详情\\n\",\n",
    "    \"    for col in categorical_found:\\n\",\n",
    "    \"        onehot_cols = [c for c in X_categorical_onehot.columns if c.startswith(f'{col}_')]\\n\",\n",
    "    \"        print(f\\\"  {col}: {len(onehot_cols)} 个 One-Hot 列\\\")\\n\",\n",
    "    \"        if len(onehot_cols) <= 10:  # 如果类别不太多，打印映射关系\\n\",\n",
    "    \"            for ocol in onehot_cols:\\n\",\n",
    "    \"                print(f\\\"    -> {ocol}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 将 One-Hot 编码与数值特征合并\\n\",\n",
    "    \"    X_numerical = X[numerical_cols].copy()\\n\",\n",
    "    \"    X_processed = pd.concat([X_numerical, X_categorical_onehot], axis=1)\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    X_processed = X[numerical_cols].copy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"\\\\n[INFO] 处理后特征维度: {X_processed.shape[1]}\\\")\\n\",\n",
