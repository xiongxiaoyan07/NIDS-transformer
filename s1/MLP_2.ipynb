    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 5. MLP 模型定义\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"class MLPClassifier(nn.Module):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    多层感知机分类器 - MLP Baseline\\n\",\n",
    "    \"\\n\",\n",
    "    \"    对应提案 Section 5.3.1:\\n\",\n",
    "    \"    输入仅为流级别统计特征 s_i，不使用任何数据包序列信息。\\n\",\n",
    "    \"\\n\",\n",
    "    \"    架构设计:\\n\",\n",
    "    \"    - 输入层: [batch, input_dim]\\n\",\n",
    "    \"    - 隐藏层: 多个全连接层 + BatchNorm + GELU + Dropout\\n\",\n",
    "    \"    - 输出层: [batch, num_classes]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    设计理由:\\n\",\n",
    "    \"    - BatchNorm1d: 稳定训练，加速收敛\\n\",\n",
    "    \"    - GELU: 现代激活函数，在负值区域更平滑的梯度\\n\",\n",
    "    \"    - Dropout: 防止过拟合，特别是在小类上\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    def __init__(self, input_dim, hidden_dims, num_classes, dropout=0.3):\\n\",\n",
    "    \"        super(MLPClassifier, self).__init__()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # 构建隐藏层\\n\",\n",
    "    \"        layers = []\\n\",\n",
    "    \"        prev_dim = input_dim\\n\",\n",
    "    \"\\n\",\n",
    "    \"        for i, hidden_dim in enumerate(hidden_dims):\\n\",\n",
    "    \"            layers.extend([\\n\",\n",
    "    \"                nn.Linear(prev_dim, hidden_dim),\\n\",\n",
    "    \"                nn.BatchNorm1d(hidden_dim),\\n\",\n",
    "    \"                nn.GELU(),\\n\",\n",
    "    \"                nn.Dropout(dropout)\\n\",\n",
    "    \"            ])\\n\",\n",
    "    \"            prev_dim = hidden_dim\\n\",\n",
    "    \"\\n\",\n",
    "    \"        self.feature_extractor = nn.Sequential(*layers)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # 分类头\\n\",\n",
    "    \"        self.classifier = nn.Linear(prev_dim, num_classes)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # 初始化\\n\",\n",
    "    \"        self._init_weights()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def _init_weights(self):\\n\",\n",
    "    \"        \\\"\\\"\\\"Xavier/Glorot 初始化，适合 GELU 激活\\\"\\\"\\\"\\n\",\n",
    "    \"        for m in self.modules():\\n\",\n",
    "    \"            if isinstance(m, nn.Linear):\\n\",\n",
    "    \"                nn.init.xavier_uniform_(m.weight)\\n\",\n",
    "    \"                if m.bias is not None:\\n\",\n",
    "    \"                    nn.init.zeros_(m.bias)\\n\",\n",
    "    \"            elif isinstance(m, nn.BatchNorm1d):\\n\",\n",
    "    \"                nn.init.ones_(m.weight)\\n\",\n",
    "    \"                nn.init.zeros_(m.bias)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def forward(self, x):\\n\",\n",
    "    \"        features = self.feature_extractor(x)\\n\",\n",
    "    \"        logits = self.classifier(features)\\n\",\n",
    "    \"        return logits\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def get_features(self, x):\\n\",\n",
    "    \"        \\\"\\\"\\\"提取中间特征（用于可视化或迁移学习）\\\"\\\"\\\"\\n\",\n",
