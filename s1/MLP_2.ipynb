    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 1. 数据加载与探索性分析 (EDA)\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\"*60)\\n\",\n",
    "    \"print(\\\"1. 数据加载与探索\\\")\\n\",\n",
    "    \"print(\\\"=\\\"*60)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 加载数据\\n\",\n",
    "    \"df = pd.read_csv(CONFIG['data_path'])\\n\",\n",
    "    \"df = df[(df['flow_id'] != 0) & (df['flow_start_timestamp_us'] != 0) &\\n\",\n",
    "    \"                df['flow_id'].notna() & df['flow_start_timestamp_us'].notna()]\\n\",\n",
    "    \"print(f\\\"[INFO] 原始数据集形状: {df.shape}\\\")\\n\",\n",
    "    \"print(f\\\"[INFO] 原始列数: {df.shape[1]}\\\")\\n\",\n",
    "    \"print(f\\\"[INFO] 原始列名:\\\\n{df.columns.tolist()}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ------------------------------------------------------------\\n\",\n",
    "    \"# Step 1: 识别并确认标签列\\n\",\n",
    "    \"# ------------------------------------------------------------\\n\",\n",
    "    \"if CONFIG['label_col'] not in df.columns:\\n\",\n",
    "    \"    print(f\\\"\\\\n[WARNING] 未找到指定标签列 '{CONFIG['label_col']}'\\\")\\n\",\n",
    "    \"    # 尝试常见标签列名\\n\",\n",
    "    \"    possible_label_names = ['Label', 'label', 'class', 'Class', 'target', 'Target', 'category']\\n\",\n",
    "    \"    found = False\\n\",\n",
    "    \"    for name in possible_label_names:\\n\",\n",
    "    \"        if name in df.columns:\\n\",\n",
    "    \"            CONFIG['label_col'] = name\\n\",\n",
    "    \"            found = True\\n\",\n",
    "    \"            print(f\\\"[INFO] 自动检测到标签列: '{name}'\\\")\\n\",\n",
    "    \"            break\\n\",\n",
    "    \"    if not found:\\n\",\n",
    "    \"        # 如果还是找不到，使用最后一列\\n\",\n",
    "    \"        CONFIG['label_col'] = df.columns[-1]\\n\",\n",
    "    \"        print(f\\\"[INFO] 使用最后一列作为标签: '{CONFIG['label_col']}'\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"\\\\n[INFO] 最终标签列: '{CONFIG['label_col']}'\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ------------------------------------------------------------\\n\",\n",
    "    \"# Step 2: 排除不需要的列\\n\",\n",
    "    \"# ------------------------------------------------------------\\n\",\n",
    "    \"# 只排除实际存在于 DataFrame 中的列\\n\",\n",
    "    \"excluded_found = [col for col in EXCLUDED_COLS if col in df.columns]\\n\",\n",
    "    \"excluded_not_found = [col for col in EXCLUDED_COLS if col not in df.columns]\\n\",\n",
    "    \"\\n\",\n",
    "    \"if excluded_not_found:\\n\",\n",
    "    \"    print(f\\\"\\\\n[INFO] 以下排除列不在数据中（已忽略）: {excluded_not_found}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"if excluded_found:\\n\",\n",
    "    \"    print(f\\\"[INFO] 排除以下列: {excluded_found}\\\")\\n\",\n",
    "    \"    df = df.drop(columns=excluded_found)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"[INFO] 排除后数据集形状: {df.shape}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ------------------------------------------------------------\\n\",\n",
    "    \"# Step 3: 分离特征和标签\\n\",\n",
    "    \"# ------------------------------------------------------------\\n\",\n",
    "    \"# 从特征列中移除标签列\\n\",\n",
    "    \"feature_cols = [col for col in df.columns if col != CONFIG['label_col']]\\n\",\n",
    "    \"X = df[feature_cols].copy()\\n\",\n",
    "    \"y = df[CONFIG['label_col']].copy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"\\\\n[INFO] 特征维度: {X.shape[1]}\\\")\\n\",\n",
    "    \"print(f\\\"[INFO] 标签列: '{CONFIG['label_col']}'\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ------------------------------------------------------------\\n\",\n",
    "    \"# Step 4: 标签分布分析\\n\",\n",
    "    \"# ------------------------------------------------------------\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"-\\\"*40)\\n\",\n",
    "    \"print(\\\"标签分布\\\")\\n\",\n",
    "    \"print(\\\"-\\\"*40)\\n\",\n",
    "    \"label_dist = y.value_counts()\\n\",\n",
    "    \"print(label_dist)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 可视化标签分布\\n\",\n",
    "    \"fig, axes = plt.subplots(1, 2, figsize=(14, 5))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 条形图\\n\",\n",
    "    \"colors = sns.color_palette('viridis', len(label_dist))\\n\",\n",
    "    \"label_dist.plot(kind='bar', ax=axes[0], color=colors, edgecolor='black')\\n\",\n",
    "    \"axes[0].set_title('Class Distribution (Count)', fontsize=14, fontweight='bold')\\n\",\n",
    "    \"axes[0].set_xlabel('Class')\\n\",\n",
    "    \"axes[0].set_ylabel('Number of Flows')\\n\",\n",
    "    \"axes[0].tick_params(axis='x', rotation=45)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 饼图（小类合并为Other）\\n\",\n",
    "    \"threshold_pct = 0.02\\n\",\n",
    "    \"label_pct = label_dist / label_dist.sum()\\n\",\n",
    "    \"major_labels = label_pct[label_pct >= threshold_pct].index\\n\",\n",
    "    \"minor_sum = label_pct[label_pct < threshold_pct].sum()\\n\",\n",
    "    \"\\n\",\n",
    "    \"pie_data = label_dist[major_labels].copy()\\n\",\n",
    "    \"if minor_sum > 0:\\n\",\n",
    "    \"    pie_data['Other'] = int(minor_sum * label_dist.sum())\\n\",\n",
    "    \"\\n\",\n",
    "    \"pie_data.plot(kind='pie', ax=axes[1], autopct='%1.1f%%',\\n\",\n",
    "    \"              colors=sns.color_palette('Set3', len(pie_data)),\\n\",\n",
    "    \"              textprops={'fontsize': 10})\\n\",\n",
    "    \"axes[1].set_title('Class Distribution (Percentage)', fontsize=14, fontweight='bold')\\n\",\n",
    "    \"axes[1].set_ylabel('')\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig('mlp_baseline_class_distribution.png', dpi=150, bbox_inches='tight')\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ------------------------------------------------------------\\n\",\n",
    "    \"# Step 5: 检查数据类型\\n\",\n",
    "    \"# ------------------------------------------------------------\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"-\\\"*40)\\n\",\n",
    "    \"print(\\\"特征数据类型\\\")\\n\",\n",
    "    \"print(\\\"-\\\"*40)\\n\",\n",
    "    \"dtype_counts = X.dtypes.value_counts()\\n\",\n",
    "    \"print(dtype_counts)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 找出所有非数值列\\n\",\n",
    "    \"non_numeric_cols = X.select_dtypes(exclude=[np.number]).columns.tolist()\\n\",\n",
    "    \"print(f\\\"\\\\n[INFO] 非数值列: {non_numeric_cols}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 确认 CATEGORICAL_COLS 是否在数据中\\n\",\n",
    "    \"categorical_found = [col for col in CATEGORICAL_COLS if col in X.columns]\\n\",\n",
    "    \"categorical_not_found = [col for col in CATEGORICAL_COLS if col not in X.columns]\\n\",\n",
    "    \"if categorical_not_found:\\n\",\n",
    "    \"    print(f\\\"[WARNING] 以下类别特征不在数据中: {categorical_not_found}\\\")\\n\",\n",
    "    \"if categorical_found:\\n\",\n",
    "    \"    print(f\\\"[INFO] 需要编码的类别特征: {categorical_found}\\\")\"\n",
    "   ],\n",
