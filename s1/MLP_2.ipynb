    "   \"source\": [\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 4. PyTorch 数据集与数据加载器\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"class FlowDataset(Dataset):\\n\",\n",
    "    \"    \\\"\\\"\\\"流级别数据集\\n\",\n",
    "    \"\\n\",\n",
    "    \"    输入: 流统计特征 s_i (shape: [num_features])\\n\",\n",
    "    \"    输出: 类别标签\\n\",\n",
    "    \"\\n\",\n",
    "    \"    这对应提案中的 Section 5.3.1 MLP Baseline:\\n\",\n",
    "    \"    仅使用 s_i（流级别聚合统计特征），不涉及任何数据包序列\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    def __init__(self, features, labels):\\n\",\n",
    "    \"        self.features = torch.FloatTensor(features)\\n\",\n",
    "    \"        self.labels = torch.LongTensor(labels)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def __len__(self):\\n\",\n",
    "    \"        return len(self.labels)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def __getitem__(self, idx):\\n\",\n",
    "    \"        return self.features[idx], self.labels[idx]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 创建数据集\\n\",\n",
    "    \"train_dataset = FlowDataset(X_train_scaled, y_train)\\n\",\n",
    "    \"val_dataset = FlowDataset(X_val_scaled, y_val)\\n\",\n",
    "    \"test_dataset = FlowDataset(X_test_scaled, y_test)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 创建数据加载器\\n\",\n",
    "    \"train_loader = DataLoader(\\n\",\n",
    "    \"    train_dataset,\\n\",\n",
    "    \"    batch_size=CONFIG['batch_size'],\\n\",\n",
    "    \"    shuffle=True,\\n\",\n",
    "    \"    num_workers=0,\\n\",\n",
    "    \"    pin_memory=True if device.type == 'cuda' else False\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"val_loader = DataLoader(\\n\",\n",
    "    \"    val_dataset,\\n\",\n",
    "    \"    batch_size=CONFIG['batch_size'],\\n\",\n",
    "    \"    shuffle=False,\\n\",\n",
    "    \"    num_workers=0,\\n\",\n",
    "    \"    pin_memory=True if device.type == 'cuda' else False\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"test_loader = DataLoader(\\n\",\n",
    "    \"    test_dataset,\\n\",\n",
    "    \"    batch_size=CONFIG['batch_size'],\\n\",\n",
    "    \"    shuffle=False,\\n\",\n",
    "    \"    num_workers=0,\\n\",\n",
    "    \"    pin_memory=True if device.type == 'cuda' else False\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"\\\\n[INFO] 数据加载器创建完成\\\")\\n\",\n",
    "    \"print(f\\\"  训练批次数: {len(train_loader)} (batch_size={CONFIG['batch_size']})\\\")\\n\",\n",
    "    \"print(f\\\"  验证批次数: {len(val_loader)}\\\")\\n\",\n",
    "    \"print(f\\\"  测试批次数: {len(test_loader)}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ------------------------------------------------------------\\n\",\n",
    "    \"# 计算类别权重（处理不平衡数据）\\n\",\n",
    "    \"# ------------------------------------------------------------\\n\",\n",
    "    \"if CONFIG['use_class_weights']:\\n\",\n",
    "    \"    class_counts = np.bincount(y_train)\\n\",\n",
    "    \"    total = len(y_train)\\n\",\n",
    "    \"    # class_weight = n_samples / (n_classes * n_samples_per_class)\\n\",\n",
    "    \"    class_weights = total / (num_classes * class_counts)\\n\",\n",
    "    \"    # 对样本数极少的类，限制权重上限避免训练不稳定\\n\",\n",
    "    \"    class_weights = np.clip(class_weights, 0.1, 10.0)\\n\",\n",
    "    \"    class_weights = torch.FloatTensor(class_weights).to(device)\\n\",\n",
    "    \"    print(f\\\"\\\\n[INFO] 类别权重 (已裁剪到 [0.1, 10.0]):\\\")\\n\",\n",
    "    \"    for i, w in enumerate(class_weights.cpu().numpy()):\\n\",\n",
    "    \"        print(f\\\"  {class_names[i]}: {w:.4f} (样本数: {class_counts[i]})\\\")\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    class_weights = None\"\n",
