    "   \"source\": [\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# Stage 1 MLP Baseline for Encrypted Traffic Classification\\n\",\n",
    "    \"# 目标: 仅使用流级别统计特征 (s_i) 训练一个 MLP 分类器\\n\",\n",
    "    \"# 用途: 作为后续 Time-aware Transformer 的性能下界 (Lower Bound)\\n\",\n",
    "    \"# 对应 Proposal Section 5.3.1\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import torch\\n\",\n",
    "    \"import torch.nn as nn\\n\",\n",
    "    \"import torch.optim as optim\\n\",\n",
    "    \"from torch.utils.data import Dataset, DataLoader\\n\",\n",
    "    \"from sklearn.model_selection import train_test_split\\n\",\n",
    "    \"from sklearn.preprocessing import StandardScaler, LabelEncoder\\n\",\n",
    "    \"from sklearn.metrics import (\\n\",\n",
    "    \"    classification_report,\\n\",\n",
    "    \"    confusion_matrix,\\n\",\n",
    "    \"    f1_score,\\n\",\n",
    "    \"    precision_score,\\n\",\n",
    "    \"    recall_score,\\n\",\n",
    "    \"    roc_auc_score\\n\",\n",
    "    \")\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import seaborn as sns\\n\",\n",
    "    \"import warnings\\n\",\n",
    "    \"import os\\n\",\n",
    "    \"from datetime import datetime\\n\",\n",
    "    \"\\n\",\n",
    "    \"warnings.filterwarnings('ignore')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 0. 全局配置与可复现性\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"def set_seed(seed=42):\\n\",\n",
    "    \"    \\\"\\\"\\\"固定随机种子，确保实验可复现\\\"\\\"\\\"\\n\",\n",
    "    \"    np.random.seed(seed)\\n\",\n",
    "    \"    torch.manual_seed(seed)\\n\",\n",
    "    \"    if torch.cuda.is_available():\\n\",\n",
    "    \"        torch.cuda.manual_seed_all(seed)\\n\",\n",
    "    \"    torch.backends.cudnn.deterministic = True\\n\",\n",
    "    \"    torch.backends.cudnn.benchmark = False\\n\",\n",
    "    \"\\n\",\n",
    "    \"set_seed(42)\\n\",\n",
    "    \"device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\\n\",\n",
    "    \"print(f\\\"[INFO] 使用设备: {device}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 实验配置（方便后续超参数调优）\\n\",\n",
    "    \"CONFIG = {\\n\",\n",
    "    \"    'data_path': '../dataset/ar002_et12_20260511_002-stage1_flows.csv',     # CSV 文件路径\\n\",\n",
    "    \"    'label_col': 'label',                 # 标签列名\\n\",\n",
    "    \"    'test_size': 0.2,                     # 测试集比例\\n\",\n",
    "    \"    'val_size': 0.1,                      # 验证集比例（从训练集中划分）\\n\",\n",
    "    \"    'batch_size': 256,                    # 批次大小\\n\",\n",
    "    \"    'learning_rate': 1e-3,               # 学习率\\n\",\n",
    "    \"    'weight_decay': 1e-5,                # L2 正则化系数\\n\",\n",
    "    \"    'num_epochs': 500,                    # 最大训练轮数\\n\",\n",
    "    \"    'early_stop_patience': 15,            # 早停耐心值\\n\",\n",
    "    \"    'hidden_dims': [512, 256, 128, 64],       # MLP 隐藏层维度\\n\",\n",
    "    \"    'dropout': 0.25,                       # Dropout 比率\\n\",\n",
    "    \"    'use_class_weights': True,            # 是否使用类别权重处理不平衡\\n\",\n",
    "    \"    'use_weighted_sampler': False,        # 是否使用加权采样器\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 需要排除的列（不用于训练）\\n\",\n",
    "    \"EXCLUDED_COLS = [\\n\",\n",
    "    \"    'flow_start_timestamp_us',\\n\",\n",
    "    \"    'flow_end_timestamp_us',\\n\",\n",
    "    \"    'source_ip',\\n\",\n",
    "    \"    'source_port',\\n\",\n",
    "    \"    'destination_ip',\\n\",\n",
    "    \"    'destination_port'\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 类别型特征（需要编码）\\n\",\n",
    "    \"CATEGORICAL_COLS = ['protocol']\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"[CONFIG] 排除的列: {EXCLUDED_COLS}\\\")\\n\",\n",
    "    \"print(f\\\"[CONFIG] 类别型特征: {CATEGORICAL_COLS}\\\")\"\n",
    "   ],\n",
