    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 6. 训练函数定义\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"def train_epoch(model, loader, criterion, optimizer, device):\\n\",\n",
    "    \"    \\\"\\\"\\\"训练一个 epoch\\\"\\\"\\\"\\n\",\n",
    "    \"    model.train()\\n\",\n",
    "    \"    total_loss = 0.0\\n\",\n",
    "    \"    all_preds = []\\n\",\n",
    "    \"    all_labels = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for features, labels in loader:\\n\",\n",
    "    \"        features, labels = features.to(device), labels.to(device)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # 前向传播\\n\",\n",
    "    \"        optimizer.zero_grad()\\n\",\n",
    "    \"        logits = model(features)\\n\",\n",
    "    \"        loss = criterion(logits, labels)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # 反向传播\\n\",\n",
    "    \"        loss.backward()\\n\",\n",
    "    \"        # 梯度裁剪（防止梯度爆炸）\\n\",\n",
    "    \"        torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)\\n\",\n",
    "    \"        optimizer.step()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # 记录\\n\",\n",
    "    \"        total_loss += loss.item() * features.size(0)\\n\",\n",
    "    \"        preds = logits.argmax(dim=1)\\n\",\n",
    "    \"        all_preds.extend(preds.cpu().numpy())\\n\",\n",
    "    \"        all_labels.extend(labels.cpu().numpy())\\n\",\n",
    "    \"\\n\",\n",
    "    \"    avg_loss = total_loss / len(loader.dataset)\\n\",\n",
    "    \"    f1_macro = f1_score(all_labels, all_preds, average='macro')\\n\",\n",
    "    \"    f1_weighted = f1_score(all_labels, all_preds, average='weighted')\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return avg_loss, f1_macro, f1_weighted\\n\",\n",
    "    \"\\n\",\n",
    "    \"def evaluate(model, loader, criterion, device):\\n\",\n",
    "    \"    \\\"\\\"\\\"评估模型，返回详细指标\\\"\\\"\\\"\\n\",\n",
    "    \"    model.eval()\\n\",\n",
    "    \"    total_loss = 0.0\\n\",\n",
    "    \"    all_preds = []\\n\",\n",
    "    \"    all_labels = []\\n\",\n",
    "    \"    all_probs = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    with torch.no_grad():\\n\",\n",
    "    \"        for features, labels in loader:\\n\",\n",
    "    \"            features, labels = features.to(device), labels.to(device)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            logits = model(features)\\n\",\n",
    "    \"            loss = criterion(logits, labels)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            total_loss += loss.item() * features.size(0)\\n\",\n",
    "    \"            probs = torch.softmax(logits, dim=1)\\n\",\n",
    "    \"            preds = logits.argmax(dim=1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            all_preds.extend(preds.cpu().numpy())\\n\",\n",
    "    \"            all_labels.extend(labels.cpu().numpy())\\n\",\n",
    "    \"            all_probs.extend(probs.cpu().numpy())\\n\",\n",
    "    \"\\n\",\n",
    "    \"    avg_loss = total_loss / len(loader.dataset)\\n\",\n",
    "    \"    all_preds = np.array(all_preds)\\n\",\n",
    "    \"    all_labels = np.array(all_labels)\\n\",\n",
    "    \"    all_probs = np.array(all_probs)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 各项指标\\n\",\n",
    "    \"    f1_macro = f1_score(all_labels, all_preds, average='macro')\\n\",\n",
    "    \"    f1_weighted = f1_score(all_labels, all_preds, average='weighted')\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 多分类 AUC (One-vs-Rest)\\n\",\n",
    "    \"    try:\\n\",\n",
    "    \"        auc_ovr = roc_auc_score(all_labels, all_probs, multi_class='ovr', average='macro')\\n\",\n",
    "    \"    except:\\n\",\n",
    "    \"        auc_ovr = 0.0\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return avg_loss, f1_macro, f1_weighted, auc_ovr, all_preds, all_labels\"\n",
