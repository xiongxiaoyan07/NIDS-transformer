    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"from s1.stage1.losses import ClassBalancedFocalLoss\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"# 7. 训练循环\\n\",\n",
    "    \"# ============================================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"=\\\"*60)\\n\",\n",
    "    \"print(\\\"7. 开始训练\\\")\\n\",\n",
    "    \"print(\\\"=\\\"*60)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 损失函数\\n\",\n",
    "    \"if CONFIG['use_class_weights'] and class_weights is not None:\\n\",\n",
    "    \"    # criterion = nn.CrossEntropyLoss(weight=class_weights)\\n\",\n",
    "    \"    criterion = ClassBalancedFocalLoss(\\n\",\n",
    "    \"            labels=y_train,\\n\",\n",
    "    \"            num_classes=2,\\n\",\n",
    "    \"            beta=0.999,\\n\",\n",
    "    \"            gamma=1.5,\\n\",\n",
    "    \"            label_smoothing=0.0,\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"    print(\\\"[INFO] 使用加权 CrossEntropyLoss\\\")\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    criterion = nn.CrossEntropyLoss()\\n\",\n",
    "    \"    print(\\\"[INFO] 使用标准 CrossEntropyLoss\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 优化器 (AdamW: 带解耦权重衰减的 Adam)\\n\",\n",
    "    \"optimizer = optim.AdamW(\\n\",\n",
    "    \"    model.parameters(),\\n\",\n",
    "    \"    lr=CONFIG['learning_rate'],\\n\",\n",
    "    \"    weight_decay=CONFIG['weight_decay']\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 学习率调度器\\n\",\n",
    "    \"scheduler = optim.lr_scheduler.ReduceLROnPlateau(\\n\",\n",
    "    \"    optimizer,\\n\",\n",
    "    \"    mode='min',           # 监控 val_loss，越小越好\\n\",\n",
    "    \"    factor=0.5,           # 学习率减半\\n\",\n",
    "    \"    patience=5,           # 5 个 epoch 无改善则降低\\n\",\n",
    "    \"    # verbose=True,\\n\",\n",
    "    \"    min_lr=1e-6           # 学习率下限\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"[INFO] 优化器: AdamW (lr={CONFIG['learning_rate']}, weight_decay={CONFIG['weight_decay']})\\\")\\n\",\n",
    "    \"print(f\\\"[INFO] 学习率调度: ReduceLROnPlateau (patience=5, factor=0.5)\\\")\\n\",\n",
    "    \"print(f\\\"[INFO] 早停: patience={CONFIG['early_stop_patience']}\\\")\\n\",\n",
    "    \"print(f\\\"[INFO] 最大 Epochs: {CONFIG['num_epochs']}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 训练历史记录\\n\",\n",
    "    \"history = {\\n\",\n",
    "    \"    'train_loss': [], 'train_f1_macro': [], 'train_f1_weighted': [],\\n\",\n",
    "    \"    'val_loss': [], 'val_f1_macro': [], 'val_f1_weighted': [], 'val_auc': []\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"best_val_f1 = 0.0\\n\",\n",
    "    \"best_epoch = 0\\n\",\n",
    "    \"patience_counter = 0\\n\",\n",
    "    \"best_model_state = None\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"-\\\"*80)\\n\",\n",
    "    \"print(f\\\"{'Epoch':<6} {'Train Loss':<12} {'Train F1':<10} {'Val Loss':<12} {'Val F1':<10} {'Val AUC':<10} {'LR':<10}\\\")\\n\",\n",
    "    \"print(\\\"-\\\"*80)\\n\",\n",
    "    \"\\n\",\n",
    "    \"for epoch in range(CONFIG['num_epochs']):\\n\",\n",
    "    \"    # 训练\\n\",\n",
    "    \"    train_loss, train_f1_macro, train_f1_weighted = train_epoch(\\n\",\n",
    "    \"        model, train_loader, criterion, optimizer, device\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 验证\\n\",\n",
    "    \"    val_loss, val_f1_macro, val_f1_weighted, val_auc, _, _ = evaluate(\\n\",\n",
    "    \"        model, val_loader, criterion, device\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 记录\\n\",\n",
    "    \"    history['train_loss'].append(train_loss)\\n\",\n",
    "    \"    history['train_f1_macro'].append(train_f1_macro)\\n\",\n",
    "    \"    history['train_f1_weighted'].append(train_f1_weighted)\\n\",\n",
    "    \"    history['val_loss'].append(val_loss)\\n\",\n",
    "    \"    history['val_f1_macro'].append(val_f1_macro)\\n\",\n",
    "    \"    history['val_f1_weighted'].append(val_f1_weighted)\\n\",\n",
    "    \"    history['val_auc'].append(val_auc)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 学习率调度\\n\",\n",
    "    \"    current_lr = optimizer.param_groups[0]['lr']\\n\",\n",
    "    \"    scheduler.step(val_loss)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 打印进度\\n\",\n",
    "    \"    if (epoch + 1) % 5 == 0 or epoch == 0:\\n\",\n",
    "    \"        print(f\\\"{epoch+1:<6} {train_loss:<12.4f} {train_f1_weighted:<10.4f} \\\"\\n\",\n",
    "    \"              f\\\"{val_loss:<12.4f} {val_f1_macro:<10.4f} {val_f1_weighted:<10.4f} {val_auc:<10.8f} {current_lr:<10.6f}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # 早停与最佳模型保存\\n\",\n",
    "    \"    if val_f1_macro > best_val_f1:\\n\",\n",
    "    \"        best_val_f1 = val_f1_macro\\n\",\n",
    "    \"        best_epoch = epoch + 1\\n\",\n",
    "    \"        patience_counter = 0\\n\",\n",
    "    \"        # 深拷贝最佳模型参数\\n\",\n",
    "    \"        best_model_state = {k: v.cpu().clone() for k, v in model.state_dict().items()}\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        patience_counter += 1\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if patience_counter >= CONFIG['early_stop_patience']:\\n\",\n",
    "    \"        print(f\\\"\\\\n[INFO] 早停触发！在第 {epoch+1} 轮停止训练\\\")\\n\",\n",
    "    \"        print(f\\\"[INFO] 最佳验证 F1: {best_val_f1:.4f} (Epoch {best_epoch})\\\")\\n\",\n",
    "    \"        break\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 加载最佳模型\\n\",\n",
    "    \"if best_model_state is not None:\\n\",\n",
    "    \"    model.load_state_dict(best_model_state)\\n\",\n",
    "    \"    print(f\\\"[INFO] 已加载最佳模型参数 (Epoch {best_epoch})\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"\\\\n[INFO] 训练完成！最佳 Epoch: {best_epoch}, 最佳 Val F1: {best_val_f1:.4f}\\\")\"\n",
    "   ],\n",
