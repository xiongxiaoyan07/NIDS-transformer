    "   \"source\": [\n",
    "    \"import os\\n\",\n",
    "    \"from collections import defaultdict, deque\\n\",\n",
    "    \"\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"from tqdm import tqdm\\n\",\n",
    "    \"\\n\",\n",
    "    \"# =====================================================\\n\",\n",
    "    \"# Configuration\\n\",\n",
    "    \"# =====================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"CSV_PATH = \\\"dataset/ar002_et12_20260511_002-stage1_flows.csv\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"OUTPUT_DIR = \\\"label_consistency\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"K_VALUES = [5,10,20,30,64,128,256,512]\\n\",\n",
    "    \"\\n\",\n",
    "    \"os.makedirs(OUTPUT_DIR, exist_ok=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# =====================================================\\n\",\n",
    "    \"# Load\\n\",\n",
    "    \"# =====================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"df = pd.read_csv(CSV_PATH)\\n\",\n",
    "    \"\\n\",\n",
    "    \"df = df.sort_values(\\n\",\n",
    "    \"    \\\"flow_start_timestamp_us\\\"\\n\",\n",
    "    \").reset_index(drop=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"N = len(df)\\n\",\n",
    "    \"\\n\",\n",
    "    \"labels = df[\\\"label\\\"].values\\n\",\n",
    "    \"\\n\",\n",
    "    \"# =====================================================\\n\",\n",
    "    \"# History\\n\",\n",
    "    \"# =====================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"source_history = defaultdict(deque)\\n\",\n",
    "    \"destination_history = defaultdict(deque)\\n\",\n",
    "    \"endpoint_history = defaultdict(deque)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# =====================================================\\n\",\n",
    "    \"# Helper\\n\",\n",
    "    \"# =====================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"def consistency(current_label, history_index):\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if len(history_index) == 0:\\n\",\n",
    "    \"        return np.nan\\n\",\n",
    "    \"\\n\",\n",
    "    \"    history_labels = labels[list(history_index)]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return np.mean(history_labels == current_label)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# =====================================================\\n\",\n",
    "    \"# Main\\n\",\n",
    "    \"# =====================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"records = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"for K in K_VALUES:\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(f\\\"\\\\nProcessing K={K}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    source_history.clear()\\n\",\n",
    "    \"    destination_history.clear()\\n\",\n",
    "    \"    endpoint_history.clear()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    source_score = np.full(N, np.nan)\\n\",\n",
    "    \"    destination_score = np.full(N, np.nan)\\n\",\n",
    "    \"    endpoint_score = np.full(N, np.nan)\\n\",\n",
    "    \"    srcdst_score = np.full(N, np.nan)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for idx,row in tqdm(df.iterrows(), total=N):\\n\",\n",
    "    \"\\n\",\n",
    "    \"        src = row.source_ip\\n\",\n",
    "    \"        dst = row.destination_ip\\n\",\n",
    "    \"\\n\",\n",
    "    \"        label = row.label\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # -----------------------------------------\\n\",\n",
    "    \"        # Same Source\\n\",\n",
    "    \"        # -----------------------------------------\\n\",\n",
    "    \"\\n\",\n",
    "    \"        history = list(source_history[src])[-K:]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        source_score[idx] = consistency(\\n\",\n",
    "    \"            label,\\n\",\n",
    "    \"            history\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # -----------------------------------------\\n\",\n",
    "    \"        # Same Destination\\n\",\n",
    "    \"        # -----------------------------------------\\n\",\n",
    "    \"\\n\",\n",
    "    \"        history = list(destination_history[dst])[-K:]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        destination_score[idx] = consistency(\\n\",\n",
    "    \"            label,\\n\",\n",
    "    \"            history\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # -----------------------------------------\\n\",\n",
    "    \"        # Same Endpoint\\n\",\n",
    "    \"        # -----------------------------------------\\n\",\n",
    "    \"\\n\",\n",
    "    \"        endpoint = set()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        endpoint.update(endpoint_history[src])\\n\",\n",
    "    \"\\n\",\n",
    "    \"        endpoint.update(endpoint_history[dst])\\n\",\n",
    "    \"\\n\",\n",
    "    \"        endpoint = sorted(endpoint)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        history = endpoint[-K:]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        endpoint_score[idx] = consistency(\\n\",\n",
    "    \"            label,\\n\",\n",
    "    \"            history\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # -----------------------------------------\\n\",\n",
    "    \"        # Same Source OR Destination\\n\",\n",
    "    \"        # -----------------------------------------\\n\",\n",
    "    \"\\n\",\n",
    "    \"        srcdst = set()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        srcdst.update(source_history[src])\\n\",\n",
    "    \"\\n\",\n",
    "    \"        srcdst.update(destination_history[dst])\\n\",\n",
    "    \"\\n\",\n",
    "    \"        srcdst = sorted(srcdst)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        history = srcdst[-K:]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        srcdst_score[idx] = consistency(\\n\",\n",
    "    \"            label,\\n\",\n",
    "    \"            history\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # -----------------------------------------\\n\",\n",
    "    \"        # Update history\\n\",\n",
    "    \"        # -----------------------------------------\\n\",\n",
    "    \"\\n\",\n",
    "    \"        source_history[src].append(idx)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        destination_history[dst].append(idx)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        endpoint_history[src].append(idx)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        endpoint_history[dst].append(idx)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # =================================================\\n\",\n",
    "    \"    # Save every flow\\n\",\n",
    "    \"    # =================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"    result = pd.DataFrame({\\n\",\n",
    "    \"\\n\",\n",
    "    \"        \\\"Same Source\\\": source_score,\\n\",\n",
    "    \"\\n\",\n",
    "    \"        \\\"Same Destination\\\": destination_score,\\n\",\n",
    "    \"\\n\",\n",
    "    \"        \\\"Same Endpoint\\\": endpoint_score,\\n\",\n",
    "    \"\\n\",\n",
    "    \"        \\\"Same Source OR Destination\\\": srcdst_score,\\n\",\n",
    "    \"\\n\",\n",
    "    \"        \\\"Label\\\": labels\\n\",\n",
    "    \"\\n\",\n",
    "    \"    })\\n\",\n",
    "    \"\\n\",\n",
    "    \"    result.to_csv(\\n\",\n",
    "    \"\\n\",\n",
    "    \"        os.path.join(\\n\",\n",
    "    \"            OUTPUT_DIR,\\n\",\n",
    "    \"            f\\\"consistency_K{K}.csv\\\"\\n\",\n",
    "    \"        ),\\n\",\n",
    "    \"\\n\",\n",
    "    \"        index=False\\n\",\n",
    "    \"\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # =================================================\\n\",\n",
    "    \"    # Summary\\n\",\n",
    "    \"    # =================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for context in [\\n\",\n",
    "    \"\\n\",\n",
    "    \"        \\\"Same Source\\\",\\n\",\n",
    "    \"\\n\",\n",
    "    \"        \\\"Same Destination\\\",\\n\",\n",
    "    \"\\n\",\n",
    "    \"        \\\"Same Endpoint\\\",\\n\",\n",
    "    \"\\n\",\n",
    "    \"        \\\"Same Source OR Destination\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    ]:\\n\",\n",
    "    \"\\n\",\n",
    "    \"        values = result[context]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        attack = values[result[\\\"Label\\\"]==1]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        benign = values[result[\\\"Label\\\"]==0]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        records.append({\\n\",\n",
    "    \"\\n\",\n",
    "    \"            \\\"Context\\\":context,\\n\",\n",
    "    \"\\n\",\n",
    "    \"            \\\"K\\\":K,\\n\",\n",
    "    \"\\n\",\n",
    "    \"            \\\"Average\\\":values.mean(),\\n\",\n",
    "    \"\\n\",\n",
    "    \"            \\\"Median\\\":values.median(),\\n\",\n",
    "    \"\\n\",\n",
    "    \"            \\\"Std\\\":values.std(),\\n\",\n",
    "    \"\\n\",\n",
    "    \"            \\\"Attack\\\":attack.mean(),\\n\",\n",
    "    \"\\n\",\n",
    "    \"            \\\"Benign\\\":benign.mean(),\\n\",\n",
    "    \"\\n\",\n",
    "    \"            \\\"No Context (%)\\\":\\n\",\n",
    "    \"\\n\",\n",
    "    \"                values.isna().mean()*100\\n\",\n",
    "    \"\\n\",\n",
    "    \"        })\\n\",\n",
    "    \"\\n\",\n",
    "    \"summary = pd.DataFrame(records)\\n\",\n",
    "    \"\\n\",\n",
    "    \"summary.to_csv(\\n\",\n",
    "    \"\\n\",\n",
    "    \"    os.path.join(\\n\",\n",
    "    \"        OUTPUT_DIR,\\n\",\n",
    "    \"        \\\"summary.csv\\\"\\n\",\n",
    "    \"    ),\\n\",\n",
    "    \"\\n\",\n",
    "    \"    index=False\\n\",\n",
    "    \"\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(summary)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# =====================================================\\n\",\n",
    "    \"# Plot\\n\",\n",
    "    \"# =====================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"for metric in [\\n\",\n",
    "    \"\\n\",\n",
    "    \"    \\\"Average\\\",\\n\",\n",
    "    \"\\n\",\n",
    "    \"    \\\"Attack\\\",\\n\",\n",
    "    \"\\n\",\n",
    "    \"    \\\"Benign\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"]:\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.figure(figsize=(8,5))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for context in summary[\\\"Context\\\"].unique():\\n\",\n",
    "    \"\\n\",\n",
    "    \"        sub = summary[\\n\",\n",
    "    \"            summary[\\\"Context\\\"]==context\\n\",\n",
    "    \"        ]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        plt.plot(\\n\",\n",
    "    \"\\n\",\n",
    "    \"            sub[\\\"K\\\"],\\n\",\n",
    "    \"\\n\",\n",
    "    \"            sub[metric],\\n\",\n",
    "    \"\\n\",\n",
    "    \"            marker=\\\"o\\\",\\n\",\n",
    "    \"\\n\",\n",
    "    \"            label=context\\n\",\n",
    "    \"\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.xlabel(\\\"K\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.ylabel(metric)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.grid(True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.legend()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.savefig(\\n\",\n",
    "    \"\\n\",\n",
    "    \"        os.path.join(\\n\",\n",
    "    \"            OUTPUT_DIR,\\n\",\n",
    "    \"            metric+\\\".png\\\"\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.close()\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\nFinished.\\\")\"\n",
