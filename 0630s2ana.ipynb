    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"# 2\\n\",\n",
    "    \"import os\\n\",\n",
    "    \"from collections import defaultdict, deque\\n\",\n",
    "    \"\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"from tqdm import tqdm\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ==========================================================\\n\",\n",
    "    \"# Configuration\\n\",\n",
    "    \"# ==========================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"CSV_PATH = \\\"dataset/ar002_et12_20260511_002-stage1_flows.csv\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"OUTPUT_DIR = \\\"context_availability\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"K_VALUES = [5, 10, 20, 30, 64, 128, 256, 512]\\n\",\n",
    "    \"\\n\",\n",
    "    \"os.makedirs(OUTPUT_DIR, exist_ok=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.rcParams[\\\"figure.dpi\\\"] = 300\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ==========================================================\\n\",\n",
    "    \"# Load Dataset\\n\",\n",
    "    \"# ==========================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Loading dataset...\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"df = pd.read_csv(CSV_PATH)\\n\",\n",
    "    \"df = df[(df['flow_id'] != 0) & (df['flow_start_timestamp_us'] != 0) &\\n\",\n",
    "    \"                df['flow_id'].notna() & df['flow_start_timestamp_us'].notna()]\\n\",\n",
    "    \"print(\\\"Sorting by timestamp...\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"df = df.sort_values(\\n\",\n",
    "    \"    \\\"flow_start_timestamp_us\\\"\\n\",\n",
    "    \").reset_index(drop=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"N = len(df)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Total flows = {N:,}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ==========================================================\\n\",\n",
    "    \"# History Index\\n\",\n",
    "    \"# ==========================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"source_history = defaultdict(deque)\\n\",\n",
    "    \"destination_history = defaultdict(deque)\\n\",\n",
    "    \"endpoint_history = defaultdict(deque)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ==========================================================\\n\",\n",
    "    \"# Statistics\\n\",\n",
    "    \"# ==========================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"summary = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ==========================================================\\n\",\n",
    "    \"# Helper\\n\",\n",
    "    \"# ==========================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"def calculate_statistics(context_lengths):\\n\",\n",
    "    \"\\n\",\n",
    "    \"    context_lengths = np.array(context_lengths)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    result = {}\\n\",\n",
    "    \"\\n\",\n",
    "    \"    result[\\\"Average\\\"] = context_lengths.mean()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    result[\\\"Median\\\"] = np.median(context_lengths)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    result[\\\"Std\\\"] = context_lengths.std()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    result[\\\"Min\\\"] = context_lengths.min()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    result[\\\"Max\\\"] = context_lengths.max()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    result[\\\"Coverage\\\"] = (\\n\",\n",
    "    \"        np.sum(context_lengths > 0)\\n\",\n",
    "    \"        / len(context_lengths)\\n\",\n",
    "    \"        * 100\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return result\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ==========================================================\\n\",\n",
    "    \"# Compute\\n\",\n",
    "    \"# ==========================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\nComputing context availability...\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"records = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"for K in K_VALUES:\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(f\\\"\\\\nProcessing K = {K}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    same_source_lengths = np.zeros(N, dtype=int)\\n\",\n",
    "    \"    same_destination_lengths = np.zeros(N, dtype=int)\\n\",\n",
    "    \"    same_endpoint_lengths = np.zeros(N, dtype=int)\\n\",\n",
    "    \"    same_srcdst_lengths = np.zeros(N, dtype=int)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    source_history.clear()\\n\",\n",
    "    \"    destination_history.clear()\\n\",\n",
    "    \"    endpoint_history.clear()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for idx, row in tqdm(df.iterrows(), total=N):\\n\",\n",
    "    \"\\n\",\n",
    "    \"        src = row.source_ip\\n\",\n",
    "    \"        dst = row.destination_ip\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # ------------------------------------------------------\\n\",\n",
    "    \"        # Same Source\\n\",\n",
    "    \"        # ------------------------------------------------------\\n\",\n",
    "    \"\\n\",\n",
    "    \"        same_source_lengths[idx] = min(\\n\",\n",
    "    \"            len(source_history[src]),\\n\",\n",
    "    \"            K\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # ------------------------------------------------------\\n\",\n",
    "    \"        # Same Destination\\n\",\n",
    "    \"        # ------------------------------------------------------\\n\",\n",
    "    \"\\n\",\n",
    "    \"        same_destination_lengths[idx] = min(\\n\",\n",
    "    \"            len(destination_history[dst]),\\n\",\n",
    "    \"            K\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # ------------------------------------------------------\\n\",\n",
    "    \"        # Same Endpoint\\n\",\n",
    "    \"        # ------------------------------------------------------\\n\",\n",
    "    \"\\n\",\n",
    "    \"        endpoint_set = set()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        endpoint_set.update(endpoint_history[src])\\n\",\n",
    "    \"        endpoint_set.update(endpoint_history[dst])\\n\",\n",
    "    \"\\n\",\n",
    "    \"        same_endpoint_lengths[idx] = min(\\n\",\n",
    "    \"            len(endpoint_set),\\n\",\n",
    "    \"            K\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # ------------------------------------------------------\\n\",\n",
    "    \"        # Same Source OR Destination\\n\",\n",
    "    \"        # ------------------------------------------------------\\n\",\n",
    "    \"\\n\",\n",
    "    \"        srcdst_set = set()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        srcdst_set.update(source_history[src])\\n\",\n",
    "    \"        srcdst_set.update(destination_history[dst])\\n\",\n",
    "    \"\\n\",\n",
    "    \"        same_srcdst_lengths[idx] = min(\\n\",\n",
    "    \"            len(srcdst_set),\\n\",\n",
    "    \"            K\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # ------------------------------------------------------\\n\",\n",
    "    \"        # Update History\\n\",\n",
    "    \"        # ------------------------------------------------------\\n\",\n",
    "    \"\\n\",\n",
    "    \"        source_history[src].append(idx)\\n\",\n",
    "    \"        destination_history[dst].append(idx)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        endpoint_history[src].append(idx)\\n\",\n",
    "    \"        endpoint_history[dst].append(idx)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # ======================================================\\n\",\n",
    "    \"    # Save individual csv\\n\",\n",
    "    \"    # ======================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"    output = pd.DataFrame({\\n\",\n",
    "    \"\\n\",\n",
    "    \"        \\\"same_source\\\": same_source_lengths,\\n\",\n",
    "    \"\\n\",\n",
    "    \"        \\\"same_destination\\\": same_destination_lengths,\\n\",\n",
    "    \"\\n\",\n",
    "    \"        \\\"same_endpoint\\\": same_endpoint_lengths,\\n\",\n",
    "    \"\\n\",\n",
    "    \"        \\\"same_source_or_destination\\\": same_srcdst_lengths\\n\",\n",
    "    \"\\n\",\n",
    "    \"    })\\n\",\n",
    "    \"\\n\",\n",
    "    \"    output.to_csv(\\n\",\n",
    "    \"\\n\",\n",
    "    \"        os.path.join(\\n\",\n",
    "    \"            OUTPUT_DIR,\\n\",\n",
    "    \"            f\\\"context_lengths_K{K}.csv\\\"\\n\",\n",
    "    \"        ),\\n\",\n",
    "    \"\\n\",\n",
    "    \"        index=False\\n\",\n",
    "    \"\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # ======================================================\\n\",\n",
    "    \"    # Statistics\\n\",\n",
    "    \"    # ======================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"    stats_source = calculate_statistics(\\n\",\n",
    "    \"        same_source_lengths\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    stats_destination = calculate_statistics(\\n\",\n",
    "    \"        same_destination_lengths\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    stats_endpoint = calculate_statistics(\\n\",\n",
    "    \"        same_endpoint_lengths\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    stats_srcdst = calculate_statistics(\\n\",\n",
    "    \"        same_srcdst_lengths\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for name, stats in [\\n\",\n",
    "    \"\\n\",\n",
    "    \"        (\\\"Same Source\\\", stats_source),\\n\",\n",
    "    \"\\n\",\n",
    "    \"        (\\\"Same Destination\\\", stats_destination),\\n\",\n",
    "    \"\\n\",\n",
    "    \"        (\\\"Same Endpoint\\\", stats_endpoint),\\n\",\n",
    "    \"\\n\",\n",
    "    \"        (\\\"Same Source OR Destination\\\", stats_srcdst)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    ]:\\n\",\n",
    "    \"\\n\",\n",
    "    \"        row = {\\n\",\n",
    "    \"\\n\",\n",
    "    \"            \\\"Context\\\": name,\\n\",\n",
    "    \"\\n\",\n",
    "    \"            \\\"K\\\": K\\n\",\n",
    "    \"\\n\",\n",
    "    \"        }\\n\",\n",
    "    \"\\n\",\n",
    "    \"        row.update(stats)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        records.append(row)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ==========================================================\\n\",\n",
    "    \"# Summary Table\\n\",\n",
    "    \"# ==========================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"summary_df = pd.DataFrame(records)\\n\",\n",
    "    \"\\n\",\n",
    "    \"summary_df.to_csv(\\n\",\n",
    "    \"\\n\",\n",
    "    \"    os.path.join(\\n\",\n",
    "    \"        OUTPUT_DIR,\\n\",\n",
    "    \"        \\\"summary.csv\\\"\\n\",\n",
    "    \"    ),\\n\",\n",
    "    \"\\n\",\n",
    "    \"    index=False\\n\",\n",
    "    \"\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(summary_df)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ==========================================================\\n\",\n",
    "    \"# Coverage Plot\\n\",\n",
    "    \"# ==========================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.figure(figsize=(8,5))\\n\",\n",
    "    \"\\n\",\n",
    "    \"for context in summary_df[\\\"Context\\\"].unique():\\n\",\n",
    "    \"\\n\",\n",
    "    \"    sub = summary_df[\\n\",\n",
    "    \"        summary_df[\\\"Context\\\"] == context\\n\",\n",
    "    \"    ]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.plot(\\n\",\n",
    "    \"        sub[\\\"K\\\"],\\n\",\n",
    "    \"        sub[\\\"Coverage\\\"],\\n\",\n",
    "    \"        marker=\\\"o\\\",\\n\",\n",
    "    \"        label=context\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.xlabel(\\\"K\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.ylabel(\\\"Coverage (%)\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.title(\\\"Context Coverage\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.grid(True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.legend()\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.savefig(\\n\",\n",
    "    \"\\n\",\n",
    "    \"    os.path.join(\\n\",\n",
    "    \"        OUTPUT_DIR,\\n\",\n",
    "    \"        \\\"coverage.png\\\"\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.close()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ==========================================================\\n\",\n",
    "    \"# Average Context Size\\n\",\n",
    "    \"# ==========================================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.figure(figsize=(8,5))\\n\",\n",
    "    \"\\n\",\n",
    "    \"for context in summary_df[\\\"Context\\\"].unique():\\n\",\n",
    "    \"\\n\",\n",
    "    \"    sub = summary_df[\\n\",\n",
