    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"from collections import deque, defaultdict\\n\",\n",
    "    \"from tqdm import tqdm\\n\",\n",
    "    \"\\n\",\n",
    "    \"# =========================\\n\",\n",
    "    \"# 1. Load data\\n\",\n",
    "    \"# =========================\\n\",\n",
    "    \"df = pd.read_csv(\\\"dataset/ar002_et12_20260511_002-stage1_flows.csv\\\")\\n\",\n",
    "    \"df = df[(df['flow_id'] != 0) & (df['flow_start_timestamp_us'] != 0) &\\n\",\n",
    "    \"                df['flow_id'].notna() & df['flow_start_timestamp_us'].notna()]\\n\",\n",
    "    \"# sort by time (CRITICAL)\\n\",\n",
    "    \"df = df.sort_values(\\\"flow_start_timestamp_us\\\").reset_index(drop=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# binary label\\n\",\n",
    "    \"df[\\\"label\\\"] = df[\\\"label\\\"].astype(int)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Total flows:\\\", len(df))\\n\",\n",
    "    \"print(\\\"Attack ratio:\\\", df[\\\"label\\\"].mean())\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# =========================\\n\",\n",
    "    \"# 2. Context containers\\n\",\n",
    "    \"# =========================\\n\",\n",
    "    \"class ContextBuffer:\\n\",\n",
    "    \"    def __init__(self, max_size):\\n\",\n",
    "    \"        self.buffer = deque(maxlen=max_size)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def add(self, item):\\n\",\n",
    "    \"        self.buffer.append(item)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def get(self):\\n\",\n",
    "    \"        return list(self.buffer)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# =========================\\n\",\n",
    "    \"# 3. Context indexing structures\\n\",\n",
    "    \"# =========================\\n\",\n",
    "    \"source_map = defaultdict(lambda: deque(maxlen=256))\\n\",\n",
    "    \"dest_map = defaultdict(lambda: deque(maxlen=256))\\n\",\n",
    "    \"endpoint_map = defaultdict(lambda: deque(maxlen=256))\\n\",\n",
    "    \"\\n\",\n",
    "    \"global_buffer = deque(maxlen=256)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# =========================\\n\",\n",
    "    \"# 4. K values\\n\",\n",
    "    \"# =========================\\n\",\n",
    "    \"K_values = [8, 16, 32, 64, 128, 256]\\n\",\n",
    "    \"\\n\",\n",
    "    \"contexts = [\\\"time\\\", \\\"source\\\", \\\"destination\\\", \\\"endpoint\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# =========================\\n\",\n",
    "    \"# 5. Result storage\\n\",\n",
    "    \"# =========================\\n\",\n",
    "    \"results = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# =========================\\n\",\n",
    "    \"# 6. Main loop\\n\",\n",
    "    \"# =========================\\n\",\n",
    "    \"for K in K_values:\\n\",\n",
    "    \"    print(f\\\"\\\\nProcessing K={K}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # reset buffers per K (important)\\n\",\n",
    "    \"    source_map = defaultdict(lambda: deque(maxlen=K))\\n\",\n",
    "    \"    dest_map = defaultdict(lambda: deque(maxlen=K))\\n\",\n",
    "    \"    endpoint_map = defaultdict(lambda: deque(maxlen=K))\\n\",\n",
    "    \"    global_buffer = deque(maxlen=K)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    stats = {\\n\",\n",
    "    \"        \\\"time\\\": [],\\n\",\n",
    "    \"        \\\"source\\\": [],\\n\",\n",
    "    \"        \\\"destination\\\": [],\\n\",\n",
    "    \"        \\\"endpoint\\\": []\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for _, row in tqdm(df.iterrows(), total=len(df)):\\n\",\n",
    "    \"        src = row[\\\"source_ip\\\"]\\n\",\n",
    "    \"        dst = row[\\\"destination_ip\\\"]\\n\",\n",
    "    \"        label = row[\\\"label\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # =========================\\n\",\n",
    "    \"        # 1. TIME CONTEXT\\n\",\n",
    "    \"        # =========================\\n\",\n",
    "    \"        time_ctx = list(global_buffer)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # =========================\\n\",\n",
    "    \"        # 2. SOURCE CONTEXT\\n\",\n",
    "    \"        # =========================\\n\",\n",
    "    \"        source_ctx = list(source_map[src])\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # =========================\\n\",\n",
    "    \"        # 3. DESTINATION CONTEXT\\n\",\n",
    "    \"        # =========================\\n\",\n",
    "    \"        dest_ctx = list(dest_map[dst])\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # =========================\\n\",\n",
    "    \"        # 4. ENDPOINT CONTEXT\\n\",\n",
    "    \"        # =========================\\n\",\n",
    "    \"        endpoint_key = (src, dst)\\n\",\n",
    "    \"        endpoint_ctx = list(endpoint_map[endpoint_key])\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # =========================\\n\",\n",
    "    \"        # compute consistency\\n\",\n",
    "    \"        # =========================\\n\",\n",
    "    \"        def compute_stats(ctx):\\n\",\n",
    "    \"            if len(ctx) == 0:\\n\",\n",
    "    \"                return None\\n\",\n",
    "    \"\\n\",\n",
    "    \"            ctx = np.array(ctx)\\n\",\n",
    "    \"\\n\",\n",
    "    \"            return {\\n\",\n",
    "    \"                \\\"consistency\\\": np.mean(ctx == label),\\n\",\n",
    "    \"                \\\"attack_ratio\\\": np.mean(ctx),\\n\",\n",
    "    \"                \\\"size\\\": len(ctx)\\n\",\n",
    "    \"            }\\n\",\n",
    "    \"\\n\",\n",
    "    \"        for name, ctx in [\\n\",\n",
    "    \"            (\\\"time\\\", time_ctx),\\n\",\n",
    "    \"            (\\\"source\\\", source_ctx),\\n\",\n",
    "    \"            (\\\"destination\\\", dest_ctx),\\n\",\n",
    "    \"            (\\\"endpoint\\\", endpoint_ctx)\\n\",\n",
    "    \"        ]:\\n\",\n",
    "    \"            s = compute_stats(ctx)\\n\",\n",
    "    \"            if s is not None:\\n\",\n",
    "    \"                stats[name].append(s)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # =========================\\n\",\n",
    "    \"        # update buffers (AFTER computing)\\n\",\n",
    "    \"        # =========================\\n\",\n",
    "    \"        global_buffer.append(label)\\n\",\n",
    "    \"        source_map[src].append(label)\\n\",\n",
    "    \"        dest_map[dst].append(label)\\n\",\n",
    "    \"        endpoint_map[endpoint_key].append(label)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # =========================\\n\",\n",
    "    \"    # aggregation\\n\",\n",
    "    \"    # =========================\\n\",\n",
    "    \"    for ctx_name in contexts:\\n\",\n",
    "    \"        arr = stats[ctx_name]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        if len(arr) == 0:\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"\\n\",\n",
    "    \"        consistency = np.mean([x[\\\"consistency\\\"] for x in arr])\\n\",\n",
    "    \"        attack_ratio = np.mean([x[\\\"attack_ratio\\\"] for x in arr])\\n\",\n",
    "    \"        sizes = np.mean([x[\\\"size\\\"] for x in arr])\\n\",\n",
    "    \"\\n\",\n",
    "    \"        results.append({\\n\",\n",
    "    \"            \\\"K\\\": K,\\n\",\n",
    "    \"            \\\"Context\\\": ctx_name,\\n\",\n",
    "    \"            \\\"ConsistencyMean\\\": consistency,\\n\",\n",
    "    \"            \\\"ContextAttackRatio\\\": attack_ratio,\\n\",\n",
    "    \"            \\\"ContextEnrichment\\\": attack_ratio / (df[\\\"label\\\"].mean() + 1e-8),\\n\",\n",
    "    \"            \\\"AvgContextSize\\\": sizes\\n\",\n",
    "    \"        })\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# =========================\\n\",\n",
    "    \"# 7. Final table\\n\",\n",
    "    \"# =========================\\n\",\n",
    "    \"result_df = pd.DataFrame(results)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\n================ FINAL TABLE ================\\\\n\\\")\\n\",\n",
    "    \"print(result_df)\\n\",\n",
    "    \"\\n\",\n",
    "    \"result_df.to_csv(\\\"label_consistency_table.csv\\\", index=False)\"\n",
    "   ],\n",
