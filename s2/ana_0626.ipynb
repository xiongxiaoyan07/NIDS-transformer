    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": [\n",
    "    \"1. 不同 Time Window 内能够找到多少历史 Flow\\n\",\n",
    "    \"如果我采用 Time Window Context，历史窗口内到底有多少可以利用的 Context？\"\n",
    "   ],\n",
    "   \"id\": \"46591192dc55d594\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-06-29T08:43:44.866329400Z\",\n",
    "     \"start_time\": \"2026-06-29T08:34:03.073799Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"# Load Flow CSV\\n\",\n",
    "    \"# ===============================\\n\",\n",
    "    \"df = pd.read_csv(\\\"../dataset/ar002_et12_20260511_001-stage1_flows.csv\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"df = df.sort_values(\\\"flow_start_timestamp_us\\\").reset_index(drop=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"timestamps = df[\\\"flow_start_timestamp_us\\\"].values\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 微秒\\n\",\n",
    "    \"windows = {\\n\",\n",
    "    \"    \\\"1s\\\": 1_000_000,\\n\",\n",
    "    \"    \\\"5s\\\": 5_000_000,\\n\",\n",
    "    \"    \\\"10s\\\":10_000_000,\\n\",\n",
    "    \"    \\\"30s\\\":30_000_000,\\n\",\n",
    "    \"    \\\"60s\\\":60_000_000,\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"=\\\"*60)\\n\",\n",
    "    \"\\n\",\n",
    "    \"for name, window in windows.items():\\n\",\n",
    "    \"\\n\",\n",
    "    \"    counts = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for i in range(len(df)):\\n\",\n",
    "    \"\\n\",\n",
    "    \"        current_time = timestamps[i]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        start_time = current_time - window\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # 找历史Flow\\n\",\n",
    "    \"        num = np.sum(\\n\",\n",
    "    \"            (timestamps[:i] >= start_time)\\n\",\n",
    "    \"            &\\n\",\n",
    "    \"            (timestamps[:i] < current_time)\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"        counts.append(num)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    counts = np.array(counts)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(f\\\"Window = {name}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(f\\\"Average Context Size : {counts.mean():.2f}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(f\\\"Median  Context Size : {np.median(counts):.2f}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(f\\\"Max     Context Size : {counts.max()}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(\\\"-\\\"*50)\"\n",
    "   ],\n",
