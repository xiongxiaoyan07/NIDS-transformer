    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ===================================\\n\",\n",
    "    \"# Load CSV\\n\",\n",
    "    \"# ===================================\\n\",\n",
    "    \"\\n\",\n",
    "    \"df = pd.read_csv(\\\"../dataset/ar002_et12_20260511_001-stage1_flows.csv\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"df = df.sort_values(\\\"flow_start_timestamp_us\\\").reset_index(drop=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"window = 30_000_000      # 30 seconds\\n\",\n",
    "    \"\\n\",\n",
    "    \"counts = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"for i in range(len(df)):\\n\",\n",
    "    \"\\n\",\n",
    "    \"    current = df.iloc[i]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    current_time = current[\\\"flow_start_timestamp_us\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    src = current[\\\"source_ip\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    dst = current[\\\"destination_ip\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    history = df.iloc[:i]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    history = history[\\n\",\n",
    "    \"        (history[\\\"flow_start_timestamp_us\\\"] >= current_time-window)\\n\",\n",
