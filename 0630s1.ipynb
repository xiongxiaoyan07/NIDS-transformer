    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"positive_flow_ids = set(\\n\",\n",
    "    \"    flows.loc[\\n\",\n",
    "    \"        flows[\\\"label\\\"] == 1,\\n\",\n",
    "    \"        \\\"flow_id\\\",\\n\",\n",
    "    \"    ]\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"positive_packets = packets[\\n\",\n",
    "    \"    packets[\\\"flow_id\\\"].isin(positive_flow_ids)\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"first_alert = (\\n\",\n",
    "    \"    positive_packets[\\n\",\n",
    "    \"        positive_packets[\\\"packet_label\\\"] == 1\\n\",\n",
    "    \"    ]\\n\",\n",
    "    \"    .groupby(\\\"flow_id\\\")[\\\"packet_index\\\"]\\n\",\n",
    "    \"    .min()\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"num_positive = len(positive_flow_ids)\\n\",\n",
    "    \"# 计算每个正流的总包数（所有正流，不仅限于有告警的）\\n\",\n",
    "    \"total_len_all = (\\n\",\n",
    "    \"    positive_packets\\n\",\n",
    "    \"    .groupby(\\\"flow_id\\\")[\\\"packet_index\\\"]\\n\",\n",
    "    \"    .max() + 1\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 定义一个判断函数，应用于所有正流（包括没有告警的）\\n\",\n",
    "    \"def target_interval_contains_alert(flow_id):\\n\",\n",
    "    \"    if flow_id not in first_alert.index:\\n\",\n",
    "    \"        return False  # 没有攻击包\\n\",\n",
    "    \"    first_idx = first_alert[flow_id]\\n\",\n",
    "    \"    total_len = total_len_all[flow_id]\\n\",\n",
    "    \"    if total_len <= 64:\\n\",\n",
    "    \"        return True  # 总长度 <= 64，攻击包一定在前64\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        return first_idx >= (total_len - 64)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 统计\\n\",\n",
    "    \"positive_flow_ids_list = list(positive_flow_ids)\\n\",\n",
    "    \"contains_flag = [target_interval_contains_alert(fid) for fid in positive_flow_ids_list]\\n\",\n",
    "    \"\\n\",\n",
    "    \"contains_true = sum(contains_flag)\\n\",\n",
    "    \"contains_false = len(contains_flag) - contains_true\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"符合条件（前64或后64包含首个攻击包）的流数:\\\", contains_true)\\n\",\n",
    "    \"print(\\\"不符合条件的流数:\\\", contains_false)\"\n",
    "   ],\n",
