    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"\\n\",\n",
    "    \"# ------------------------------------------------------------\\n\",\n",
    "    \"# Step 4: 标签分布分析\\n\",\n",
    "    \"# ------------------------------------------------------------\\n\",\n",
    "    \"print(\\\"\\\\n\\\" + \\\"-\\\"*40)\\n\",\n",
    "    \"print(\\\"标签分布\\\")\\n\",\n",
    "    \"print(\\\"-\\\"*40)\\n\",\n",
    "    \"\\n\",\n",
    "    \"y = flows['label'].copy()\\n\",\n",
    "    \"label_dist = y.value_counts()\\n\",\n",
    "    \"print(label_dist)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 可视化标签分布\\n\",\n",
    "    \"fig, axes = plt.subplots(1, 2, figsize=(14, 5))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 条形图\\n\",\n",
    "    \"colors = sns.color_palette('viridis', len(label_dist))\\n\",\n",
    "    \"label_dist.plot(kind='bar', ax=axes[0], color=colors, edgecolor='black')\\n\",\n",
    "    \"axes[0].set_title('Class Distribution (Count)', fontsize=14, fontweight='bold')\\n\",\n",
    "    \"axes[0].set_xlabel('Class')\\n\",\n",
    "    \"axes[0].set_ylabel('Number of Flows')\\n\",\n",
    "    \"axes[0].tick_params(axis='x', rotation=45)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 饼图（小类合并为Other）\\n\",\n",
    "    \"threshold_pct = 0.02\\n\",\n",
    "    \"label_pct = label_dist / label_dist.sum()\\n\",\n",
    "    \"major_labels = label_pct[label_pct >= threshold_pct].index\\n\",\n",
    "    \"minor_sum = label_pct[label_pct < threshold_pct].sum()\\n\",\n",
    "    \"\\n\",\n",
    "    \"pie_data = label_dist[major_labels].copy()\\n\",\n",
    "    \"if minor_sum > 0:\\n\",\n",
    "    \"    pie_data['Other'] = int(minor_sum * label_dist.sum())\\n\",\n",
    "    \"\\n\",\n",
    "    \"pie_data.plot(kind='pie', ax=axes[1], autopct='%1.1f%%',\\n\",\n",
    "    \"              colors=sns.color_palette('Set3', len(pie_data)),\\n\",\n",
    "    \"              textprops={'fontsize': 10})\\n\",\n",
    "    \"axes[1].set_title('Class Distribution (Percentage)', fontsize=14, fontweight='bold')\\n\",\n",
    "    \"axes[1].set_ylabel('')\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig('class_distribution.png', dpi=150, bbox_inches='tight')\\n\",\n",
    "    \"plt.show()\"\n",
